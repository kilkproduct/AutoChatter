{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["plugins/auto-chatter/js/**/*", "tests/**/*", "types/**/*"],
  "exclude": ["node_modules", "plugins/auto-chatter/build"]
}
